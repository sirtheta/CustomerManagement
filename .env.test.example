# Test-Umgebung Konfiguration
# Diese Datei als .env.test kopieren und Werte anpassen
# .env.test wird NICHT ins Git eingecheckt (siehe .gitignore)
# Wird ausschliesslich von docker-compose.test.yml via env_file geladen
# (Vitest liest diese Datei nicht).

AUTH_SECRET=<zufaelliger-32-Zeichen-String-hier-eintragen>
AUTH_URL=https://test.deinedomain.ch
ADMIN_EMAIL=admin@test.local
ADMIN_NAME=Admin
ADMIN_PASSWORD=changeme123

# DATABASE_URL, NODE_ENV, DISABLE_EMAIL, DISABLE_TELEGRAM und DISABLE_USER_MUTATIONS
# werden von docker-compose.test.yml fest im "environment:"-Block gesetzt und
# ueberschreiben hier gesetzte Werte immer — daher absichtlich nicht hier definiert.