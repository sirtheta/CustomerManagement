generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Customer {
  customerId              Int        @id @default(autoincrement())
  company                 String?
  contactPerson           String
  street                  String
  houseNumber             String?
  city                    String
  zipCode                 String
  country                 String     @default("CH")
  addressNeedsReview      Boolean    @default(false)
  email                   String
  phone                   String?
  contactInsteadOfCompany Boolean    @default(false)
  archivedAt              DateTime?
  invoices                Invoice[]
  quotes                  Quote[]
  documents               Document[]
  notes                   CustomerNote[]
  subscriptions           Subscription[]

  @@index([email])
  @@index([archivedAt])
}

model Invoice {
  id             Int              @id @default(autoincrement())
  customerId     Int
  documentNumber String?
  customUserText String?
  date           DateTime
  version        Int              @default(1)
  totalAmount    Decimal
  dueDate        DateTime
  discountPercent Decimal  @default(0)
  state          InvoiceState     @default(Draft)
  paidDate       DateTime?
  creditNoteForId Int?
  customer       Customer         @relation(fields: [customerId], references: [customerId], onDelete: Restrict)
  creditNoteFor  Invoice?         @relation("CreditNotes", fields: [creditNoteForId], references: [id], onDelete: Restrict)
  creditNotes    Invoice[]        @relation("CreditNotes")
  items           Item[]
  pendingEmail    PendingEmail?
  sentLogs        InvoiceSentLog[]
  pendingReminder PendingReminder?
  payments        Payment[]
  sentDocuments   SentDocument[]

  @@unique([documentNumber])
  @@index([customerId])
  @@index([date])
  @@index([state])
  @@index([dueDate])
  @@index([paidDate])
  @@index([creditNoteForId])
}

model Payment {
  id            Int      @id @default(autoincrement())
  invoiceId     Int
  date          DateTime
  amount        Decimal
  source        String   @default("manual") // manual | camt-import | budget-import | migration
  bankReference String?
  createdAt     DateTime @default(now())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction?

  @@index([invoiceId])
  @@index([date])
}

model InvoiceSentLog {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  sentAt    DateTime @default(now())
  sentTo    String
  subject   String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model SentDocument {
  id             Int      @id @default(autoincrement())
  invoiceId      Int
  kind           String // Invoice | Reminder
  reminderLevel  Int?
  documentNumber String
  path           String // relative to the archive root, e.g. 2026/I-26090001_Invoice_20260930T101500123Z.pdf
  sha256         String
  size           Int
  sentTo         String
  subject        String
  createdAt      DateTime @default(now())
  createdById    Int
  // Reminder only (kind = "Reminder"): the amounts printed on the Mahnbeleg.
  openRappen     Int?
  feeRappen      Int?
  interestRappen Int?
  interestPercent Decimal?
  dunningDate    DateTime?
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model QuoteSentLog {
  id      Int      @id @default(autoincrement())
  quoteId Int
  sentAt  DateTime @default(now())
  sentTo  String
  subject String
  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model PendingEmail {
  id              Int       @id @default(autoincrement())
  invoiceId       Int       @unique
  to              String
  subject         String
  body            String
  createdAt       DateTime  @default(now())
  adminNotifiedAt DateTime?
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Quote {
  id             Int        @id @default(autoincrement())
  customerId     Int
  documentNumber String?
  customUserText String?
  date           DateTime
  version        Int        @default(1)
  totalAmount    Decimal
  validUntil     DateTime
  discountPercent Decimal   @default(0)
  state          QuoteState @default(Draft)
  customer       Customer   @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  items          Item[]
  sentLogs       QuoteSentLog[]

  @@unique([documentNumber])
  @@index([customerId])
  @@index([date])
  @@index([state])
  @@index([validUntil])
}

model Item {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  unit        Unit
  unitPrice   Decimal
  quantity    Decimal
  discountPercent Decimal @default(0)
  totalAmount Decimal
  customText  String?
  categoryId  Int?
  invoiceId   Int?
  quoteId     Int?
  category    Category? @relation(fields: [categoryId], references: [categoryId])
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id])
  quote       Quote?    @relation(fields: [quoteId], references: [id])

  @@index([invoiceId])
  @@index([quoteId])
  @@index([categoryId])
}

model InvoiceTemplate {
  id    Int            @id @default(autoincrement())
  name  String
  items TemplateItem[]
  subscriptions Subscription[]
}

model TemplateItem {
  id          Int             @id @default(autoincrement())
  templateId  Int
  name        String
  description String?
  unit        Unit
  unitPrice   Decimal
  quantity    Decimal
  categoryId  Int?
  template    InvoiceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

enum SubscriptionInterval {
  Monthly
  Quarterly
  Yearly
}

model Subscription {
  id              Int                  @id @default(autoincrement())
  customerId      Int
  templateId      Int?
  interval        SubscriptionInterval
  nextInvoiceDate DateTime
  autoSend        Boolean              @default(false)
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  customer        Customer             @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  template        InvoiceTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([nextInvoiceDate])
  @@index([customerId])
}

model Service {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  unit        Unit
  unitPrice   Decimal
  isActive    Boolean   @default(true)
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [categoryId])
}

model Category {
  categoryId Int       @id @default(autoincrement())
  name       String
  isActive   Boolean   @default(true)
  colorHex   String?
  items      Item[]
  services   Service[]
  expenses   Expense[]
}

model Expense {
  id          Int       @id @default(autoincrement())
  date        DateTime
  description String
  amount      Decimal
  categoryId  Int?
  notes       String?
  supplier    String?
  dueDate     DateTime?
  // null = open supplier invoice, otherwise the day it was paid
  paidDate    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    Category? @relation(fields: [categoryId], references: [categoryId])
  receipts    ExpenseReceipt[]
  bankTransaction BankTransaction?

  @@index([date])
  @@index([categoryId])
  @@index([paidDate])
}

model ExpenseReceipt {
  id         Int      @id @default(autoincrement())
  expenseId  Int
  name       String
  fileType   String
  size       Int
  uploadDate DateTime @default(now())
  content    Bytes
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model Document {
  documentId Int      @id @default(autoincrement())
  customerId Int
  name       String
  fileType   String
  uploadDate DateTime
  content    Bytes
  note       String?
  customer   Customer @relation(fields: [customerId], references: [customerId], onDelete: Cascade)

  @@index([customerId])
}

model CustomerNote {
  noteId     Int      @id @default(autoincrement())
  customerId Int
  title      String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [customerId], onDelete: Cascade)

  @@index([customerId])
}

model CompanyInformation {
  companyInformationId Int                  @id @default(autoincrement())
  companyName          String?
  companyHolderName    String?
  companyStreet        String?
  companyHouseNumber   String?
  companyZip           String?
  companyCity          String?
  companyCountry       String               @default("CH")
  companyAddressNeedsReview Boolean         @default(false)
  companyEmail         String?
  companyPhone         String?
  companyIBAN          String?
  companyLogo          Bytes?
  settings             ApplicationSettings?
}

model ApplicationSettings {
  applicationSettingsId    Int                @id @default(autoincrement())
  numberFormat             String             @default("de-CH")
  defaultPaymentTermDays   Int                @default(30)
  defaultQuoteValidityDays Int                @default(30)
  invoiceNumberPrefix      String             @default("I-")
  quoteNumberPrefix        String             @default("Q-")
  defaultYearlyInvoice     Boolean            @default(false)
  useHolderNameOnQR        Boolean            @default(false)
  smtpHost                 String?
  smtpPort                 Int?
  smtpUser                 String?
  smtpPassword             String?
  smtpFromName             String?
  smtpFromAddress          String?
  emailSubjectTemplate     String?
  emailBodyTemplate        String?
  reminderCooldownDays     Int                @default(14)
  reminderFeeLevel2Rappen  Int                @default(0)
  reminderFeeLevel3Rappen  Int                @default(0)
  reminderFeeLevel4Rappen  Int                @default(0)
  reminderInterestPercent  Decimal            @default(0)
  notifyOverdueEnabled     Boolean            @default(false)
  notifyPendingEnabled     Boolean            @default(false)
  notifyEmailAddress       String?
  notifyTelegramBotToken   String?
  notifyTelegramChatId     String?
  notifyRepeatIntervalDays Int?
  pdfTheme                 Json?
  companyInformationId     Int                @unique
  companyInfo              CompanyInformation @relation(fields: [companyInformationId], references: [companyInformationId], onDelete: Cascade)
}

model PendingReminder {
  id              Int       @id @default(autoincrement())
  invoiceId       Int       @unique
  reminderLevel   Int       @default(1)
  snoozedUntil    DateTime?
  createdAt       DateTime  @default(now())
  adminNotifiedAt DateTime?
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  userName   String
  action     String
  entityType String
  entityId   Int?
  entityRef  String?
  details    String?
  createdAt  DateTime @default(now())
  // Hash chain (F4 part B): null on rows written before the chain existed.
  // prevHash is unique so every hash has at most one successor; the first
  // chained row uses the "GENESIS" sentinel instead of null (SQLite allows
  // many NULLs in a unique index).
  prevHash   String?  @unique
  hash       String?

  @@index([createdAt])
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  totpSecret      String?
  totpEnabled     Boolean   @default(false)
  totpBackupCodes String?   // JSON array of bcrypt-hashed one-time backup codes
  role            UserRole  @default(Viewer)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Bumped whenever the password is reset (self-service or by an admin).
  // The JWT carries the epoch it was issued under; lib/auth.ts's session
  // callback rejects a token once this value has moved on, which is what
  // makes a reset actually revoke sessions that are already out there.
  sessionEpoch Int @default(0)

  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserRole {
  Admin
  Editor
  Viewer
}

enum InvoiceState {
  Draft
  Sent
  PartiallyPaid
  Paid
  Overdue
  Canceled
}

enum QuoteState {
  Draft
  Sent
  Accepted
  Declined
  Expired
}

enum Unit {
  Hour
  Day
  Piece
  Package
}

model BankStatementImport {
  id                   Int       @id @default(autoincrement())
  filename             String
  iban                 String?
  currency             String?
  periodFrom           String?   // YYYY-MM-DD
  periodTo             String?   // YYYY-MM-DD
  openingBalanceRappen Int?
  closingBalanceRappen Int?
  /// Balance warnings shown at upload time, kept for the import history.
  balanceWarning       String?
  importedCount        Int
  skippedCount         Int
  userId               Int?
  createdAt            DateTime  @default(now())
  transactions         BankTransaction[]

  @@index([createdAt])
  @@index([iban, periodTo])
}

/// One booked entry of an imported CAMT.053 statement. Open = no payment,
/// no expense and not ignored; there is deliberately no status column that
/// could disagree with the payments (deleting a Payment/Expense sets the
/// link to null and the row is open again).
model BankTransaction {
  id            Int      @id @default(autoincrement())
  importId      Int
  fingerprint   String   @unique
  date          DateTime
  /// Signed Rappen: negative = money out.
  amountRappen  Int
  description   String
  counterparty  String?
  bankReference String?
  ignored       Boolean  @default(false)
  paymentId     Int?     @unique
  expenseId     Int?     @unique
  createdAt     DateTime @default(now())

  statementImport BankStatementImport @relation(fields: [importId], references: [id], onDelete: Restrict)
  payment         Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  expense         Expense?            @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([importId])
  @@index([date])
}
