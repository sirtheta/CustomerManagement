# ── Datenbank ─────────────────────────────────────────────────────────────────
# Wird von docker-compose überschrieben (file:/app/data/...)
# Für lokale Entwicklung:
DATABASE_URL="file:./data/customermanagement.db"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Zufälliger Secret (min. 32 Zeichen):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="ersetzen-mit-zufaelligem-string-min-32-zeichen"

# URL der Applikation (für Redirects nach Login)
AUTH_URL="https://customers.deine-domain.ch"

# Session-Dauer in Sekunden (Standard: 7 Tage)
# SESSION_MAX_AGE_SEC=604800
# Wie oft das JWT erneuert wird, solange der User aktiv ist (Standard: 24h)
# SESSION_UPDATE_AGE_SEC=86400

# ── Erster Admin-User (automatisch beim Start angelegt, falls keine User existieren)
# Ohne ADMIN_PASSWORD/ADMIN_PASSWORD_HASH wird ein zufälliges Passwort generiert
# und einmalig im Startup-Log ausgegeben — nach dem ersten Login sofort ändern.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_NAME="Admin"
# ADMIN_PASSWORD="sicheres-passwort"   # wird automatisch gehasht
# oder direkt als Hash (bcrypt, cost 10):
# ADMIN_PASSWORD_HASH="$2b$10$..."

# ── Benachrichtigungen ────────────────────────────────────────────────────────
# Cron-Schedule für tägliche Benachrichtigungen (Standard: täglich um 8 Uhr)
NOTIFY_CRON_SCHEDULE="0 8 * * *"

# ── Budget-Integration ────────────────────────────────────────────────────────
# Shared Secret für den internen Endpoint POST /api/external/payments, über den
# die Budget-App (separater Container) importierte Zahlungen gegen offene
# Rechnungen abgleicht. Ohne diesen Wert bleibt der Endpoint deaktiviert (401).
# BUDGET_INTEGRATION_API_KEY="zufaelliger-shared-secret"

# ── Sicherheit / Rate-Limiting ────────────────────────────────────────────────
# Maximale Login-Versuche pro Zeitfenster (Standard: 5)
# RATE_LIMIT_MAX_ATTEMPTS=5
# Zeitfenster für Rate-Limiting in Millisekunden (Standard: 15 Minuten)
# RATE_LIMIT_WINDOW_MS=900000

# bcrypt-Runden für Passwort-Hashing (Standard: 10, höher = sicherer aber langsamer)
# BCRYPT_ROUNDS=10

# ── PDF-Cache ─────────────────────────────────────────────────────────────────
# Verzeichnis für gecachte PDFs (Standard: data/pdf-cache)
# PDF_CACHE_DIR=data/pdf-cache
# Maximale Anzahl gecachter PDFs (Standard: 100)
# PDF_CACHE_MAX_FILES=100
# Cache-Lebensdauer in Millisekunden (Standard: 10 Minuten)
# PDF_CACHE_TTL_MS=600000

# ── Logging ───────────────────────────────────────────────────────────────────
# Log-Level: trace | debug | info | warn | error (Standard: info)
# LOG_LEVEL=info

# Nächtliche Log-Rotation (data/logs/app.log -> app-<Datum>.log), abrufbar als
# Admin unter Einstellungen → Logs.
# LOG_ROTATE_CRON_SCHEDULE="35 2 * * *"
# Aufbewahrung der rotierten Logdateien in Tagen; 0 = alle behalten.
# LOG_MAX_KEEP_DAYS=14

# ── Entwicklung / Staging ─────────────────────────────────────────────────────
# E-Mail-Versand deaktivieren (z.B. in Staging-Umgebungen)
# DISABLE_EMAIL=true
# Telegram-Benachrichtigungen deaktivieren
# DISABLE_TELEGRAM=true
# User-Verwaltung deaktivieren (z.B. für Demo-Instanzen)
# DISABLE_USER_MUTATIONS=true
# Nächtliche Log-Rotation deaktivieren
# DISABLE_LOG_ROTATION=true
