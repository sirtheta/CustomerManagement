{
  "name": "customer-management",
  "version": "1.3.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:server": "prisma migrate deploy && tsx prisma/seed.ts && node -e \"require('child_process').execSync('next dev -p ' + (process.env.PORT || '3100'), { stdio: 'inherit' })\"",
    "marketing:screenshots": "tsx scripts/marketing-screenshots.ts",
    "marketing:html": "tsx scripts/generate-marketing-html.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
